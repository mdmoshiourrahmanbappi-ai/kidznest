# Copy to .env for local testing. On the host (Render/Railway) enter these as Environment Variables instead.
NODE_ENV=production
PORT=3000
# Public address of the website, https, no trailing slash. Stripe sends customers back here.
BASE_URL=https://www.kidznestplaycafe.co.uk
# Where the database lives. MUST be on a persistent disk/volume on your host.
DATA_DIR=./data

# Admin dashboard at /admin  (use a long, unique password)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Stripe (Dashboard > Developers). Use sk_test_... while testing, sk_live_... to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI chat (console.anthropic.com). Leave blank to use the website's built-in answers instead.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# Email (any SMTP provider). Leave SMTP_HOST blank to disable emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kidz Nest Play Café <bookings@kidznestplaycafe.co.uk>
OWNER_EMAIL=Kidznest01@yahoo.com
